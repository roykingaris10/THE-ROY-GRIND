{
  "expo": {
    "name": "Invictus",
    "slug": "invictus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invictus",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0814"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.invictus.fitness",
      "buildNumber": "5",
      "infoPlist": {
        "NSMotionUsageDescription": "Invictus uses motion data to count your daily steps."
      }
    },
    "android": {
      "package": "com.invictus.fitness",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0814"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png"
        }
      ],
      "expo-sensors",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "083699fe-2a04-4e69-961d-f5bfecdab9cf"
      }
    }
  }
}
